{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a02 declarations file",
  "type": "object",
  "required": ["format", "generatedAt", "sdk", "source", "dataTypesByGroup", "apps"],
  "properties": {
    "format": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sdk": { "type": "integer" },
    "source": {
      "type": "object",
      "required": ["declarations"],
      "properties": {
        "declarations": { "enum": ["none", "manual", "licensed"] },
        "note": { "type": "string" }
      }
    },
    "dataTypesByGroup": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/dataType" } }
    },
    "tierByGroup": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 3 }
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["readAt", "declared"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "developer": { "type": ["string", "null"] },
          "policyUrl": { "type": ["string", "null"], "format": "uri" },
          "readAt": { "type": ["string", "null"], "format": "date" },
          "listing": { "enum": ["present", "removed"] },
          "versionCode": { "type": ["integer", "null"] },
          "declared": {
            "type": ["object", "null"],
            "required": ["collected", "shared"],
            "properties": {
              "collected": { "type": "array", "items": { "$ref": "#/$defs/dataType" } },
              "shared": { "type": "array", "items": { "$ref": "#/$defs/dataType" } }
            }
          },
          "security": {
            "type": ["object", "null"],
            "properties": {
              "encryptedInTransit": { "type": ["boolean", "null"] },
              "deletionRequest": { "type": ["boolean", "null"] },
              "familiesPolicy": { "type": "boolean" },
              "independentReview": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dataType": {
      "enum": ["Location", "Personal info", "Financial info", "Health and fitness", "Messages",
        "Photos and videos", "Audio", "Files and docs", "Calendar", "Contacts", "App activity",
        "Web browsing", "App info and performance", "Device or other IDs"]
    }
  }
}
